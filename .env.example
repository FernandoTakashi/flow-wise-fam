# ── Frontend (Vite) ─────────────────────────────────────────────
# Copie para .env e preencha com os valores do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
# nome do bot do Telegram (sem @) — usado no link "Conectar Telegram"
VITE_TELEGRAM_BOT_USERNAME=SeuFinanceBot

# ── Backend (Vercel Functions — NÃO expor no frontend) ──────────
# Defina no painel da Vercel (Project > Settings > Environment Variables).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-aqui
ANTHROPIC_API_KEY=sk-ant-...            # opcional: sem ela o bot cai em regex (só lançar)
ANTHROPIC_WORKSPACE_ID=wrkspc_...       # só se a key NÃO for de um workspace (erro "not scoped to a workspace")
TELEGRAM_BOT_TOKEN=123456:ABC-...       # do @BotFather
TELEGRAM_BOT_USERNAME=SeuFinanceBot     # mesmo valor do VITE_ acima
TELEGRAM_WEBHOOK_SECRET=uma-string-aleatoria-longa
CRON_SECRET=outra-string-aleatoria-longa
PUBLIC_APP_URL=https://seu-app.vercel.app
